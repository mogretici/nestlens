# Install `nestlens` (a `file:..` dependency) as a copy rather than a symlink.
#
# With a symlink, Node resolves NestLens's own imports from the repo root's
# node_modules while the example app resolves them from its own — two copies of
# @nestjs/core, two ModulesContainer classes, and a bootstrap failure:
#   Nest can't resolve dependencies of DiscoveryService (ModulesContainer)
#
# Copying keeps a single @nestjs instance for the whole app. The trade-off is
# that library changes need `npm run build` at the repo root followed by
# `npm install` here before they show up.
install-links=true
