{
  "name": "nestlens",
  "version": "0.14.2",
  "description": "Laravel Telescope-like debugging and monitoring tool for NestJS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./storage/sqlite": {
      "types": "./dist/core/storage/sqlite.storage.d.ts",
      "default": "./dist/core/storage/sqlite.storage.js"
    },
    "./storage/redis": {
      "types": "./dist/core/storage/redis.storage.d.ts",
      "default": "./dist/core/storage/redis.storage.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "storage/sqlite": [
        "dist/core/storage/sqlite.storage.d.ts"
      ],
      "storage/redis": [
        "dist/core/storage/redis.storage.d.ts"
      ]
    }
  },
  "type": "commonjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && npm run build:dashboard",
    "build:lib": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:dashboard": "cd dashboard && npm run build && mkdir -p ../dist/dashboard/public && cp -r dist/* ../dist/dashboard/public/",
    "dev": "tsc --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:smoke": "node scripts/smoke-published-package.mjs",
    "benchmark": "node --expose-gc scripts/benchmark.mjs",
    "benchmark:sanitizer": "node scripts/benchmark-sanitizer.mjs",
    "benchmark:load": "node --expose-gc scripts/benchmark-load.mjs",
    "prepublishOnly": "npm run build",
    "sync-versions": "node -e \"const fs=require('fs');const pkg=require('./package.json');const dash=require('./dashboard/package.json');dash.version=pkg.version;fs.writeFileSync('./dashboard/package.json',JSON.stringify(dash,null,2)+'\\n')\"",
    "prepare": "husky"
  },
  "keywords": [
    "nestjs",
    "debugging",
    "monitoring",
    "telescope",
    "devtools",
    "logging",
    "tracing",
    "profiling",
    "dashboard",
    "queries",
    "requests",
    "exceptions",
    "jobs",
    "cache",
    "redis",
    "bull",
    "prisma",
    "typeorm",
    "graphql",
    "apollo",
    "mercurius",
    "subscriptions",
    "n+1"
  ],
  "author": "mogretici",
  "license": "MIT",
  "homepage": "https://github.com/mogretici/nestlens#readme",
  "bugs": {
    "url": "https://github.com/mogretici/nestlens/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mogretici/nestlens.git"
  },
  "peerDependencies": {
    "@apollo/server": "^4.0.0 || ^5.0.0",
    "@nestjs/apollo": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0 || ^13.0.0",
    "@nestjs/cache-manager": "^1.0.0 || ^2.0.0 || ^3.0.0",
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@nestjs/core": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@nestjs/graphql": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0 || ^13.0.0",
    "@nestjs/mercurius": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0 || ^13.0.0",
    "better-sqlite3": "^11.0.0 || ^12.0.0 || ^13.0.0",
    "bullmq": "^3.0.0 || ^4.0.0 || ^5.0.0 || ^6.0.0",
    "graphql": "^15.0.0 || ^16.0.0 || ^17.0.0",
    "ioredis": "^5.0.0",
    "mercurius": "^12.0.0 || ^13.0.0 || ^14.0.0 || ^15.0.0 || ^16.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@apollo/server": {
      "optional": true
    },
    "@nestjs/apollo": {
      "optional": true
    },
    "@nestjs/cache-manager": {
      "optional": true
    },
    "@nestjs/graphql": {
      "optional": true
    },
    "@nestjs/mercurius": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "graphql": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "mercurius": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/express": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "uuid": "^11.0.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.6.0"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/mercurius": "^13.4.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/testing": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@playwright/test": "^1.57.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/ioredis-mock": "^8.2.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "axios": "^1.19.0",
    "better-sqlite3": "^12.11.1",
    "cache-manager": "^7.2.9",
    "cron": "^4.4.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^10.1.8",
    "fastify": "^5.12.1",
    "graphql": "^16.14.2",
    "husky": "^9.1.7",
    "ioredis": "^5.4.1",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "mercurius": "^16.10.0",
    "prettier": "^3.7.4",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "semantic-release": "^25.0.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsc-alias": "^1.8.16",
    "typeorm": "^0.3.20",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
